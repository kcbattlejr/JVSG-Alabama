# Runtime: local or azure
JVSG_RUNTIME_MODE=local

# Local Ollama endpoint (optional; no connection is made by default)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b-instruct

# Azure / Microsoft Graph integration settings (optional)
AZURE_OPENAI_ENDPOINT=
AZURE_KEY_VAULT_URL=
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=

# Supply secrets through an approved secret manager or local environment.
# Do not put real values in this tracked example file.
SID_HMAC_SECRET=
