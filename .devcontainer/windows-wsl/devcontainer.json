{
  "name": "JVSG-Alabama / WSL container / Python 3.11",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "runArgs": ["--name", "jvsg-dev", "--restart", "unless-stopped"],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "remoteUser": "vscode",
  "updateRemoteUserUID": false,
  "shutdownAction": "none",
  "remoteEnv": {
    "VIRTUAL_ENV": "/home/vscode/.venvs/jvsg",
    "PATH": "/home/vscode/.venvs/jvsg/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "bash .devcontainer/scripts/setup.sh && git config --global core.autocrlf true",
  "postStartCommand": "/home/vscode/.venvs/jvsg/bin/python -m pip check",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venvs/jvsg/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true,
        "[python]": {"editor.defaultFormatter": "charliermarsh.ruff"}
      },
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "charliermarsh.ruff"]
    }
  }
}
